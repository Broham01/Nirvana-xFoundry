# Pinned platform versions for the dev cluster. Checked against upstream release tags on 2026-10-20.
KIND_CLUSTER=xfoundry
KUBE_OVN_VERSION=v1.16.14
MULTUS_VERSION=v4.3.1
KUBEVIRT_VERSION=v1.9.1
CDI_VERSION=v1.66.1
NOVNC_VERSION=v1.7.0          # VM consoles in the browser (platform/dev/console.sh)
CONSOLE_PORT=${CONSOLE_PORT:-8011}

# xFoundry's own Linux VM (a Colima instance), separate from Docker Desktop. Override any of these in your shell.
XFOUNDRY_VM=${XFOUNDRY_VM:-xfoundry}
XFOUNDRY_VM_CPUS=${XFOUNDRY_VM_CPUS:-6}
XFOUNDRY_VM_MEMORY=${XFOUNDRY_VM_MEMORY:-10}   # GiB
XFOUNDRY_VM_DISK=${XFOUNDRY_VM_DISK:-60}       # GiB
